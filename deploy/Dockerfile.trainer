FROM python:3.12-slim

RUN apt-get update -qq && apt-get install -y -qq git curl && rm -rf /var/lib/apt/lists/*

# Install uv and mat
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.cargo/bin:/root/.local/bin:$PATH"
RUN uv tool install multiagenttrainer

# mat-query: stdlib-only helper that calls the vLLM chat endpoint.
# Installed to /usr/local/bin so agent_command subprocesses can find it.
COPY mat-query /usr/local/bin/mat-query
RUN chmod +x /usr/local/bin/mat-query

COPY train.sh /train.sh
RUN chmod +x /train.sh

VOLUME ["/output"]

ENTRYPOINT ["/train.sh"]
